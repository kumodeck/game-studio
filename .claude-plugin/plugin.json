{
  "name": "game-studio",
  "displayName": "KUMODeck Game Studio",
  "description": "Turn your Claude or Codex into a game studio: a free, local editor where you drag, turn and resize the objects in your web game, see every asset it uses, and ask your AI for changes. three.js works out of the box; your AI writes a small adapter for Phaser, PixiJS, canvas, DOM, or Godot web games. No account needed.",
  "version": "0.1.22",
  "author": {
    "name": "KUMODeck",
    "email": "support@kumodeck.com"
  },
  "homepage": "https://github.com/kumodeck/game-studio",
  "repository": "https://github.com/kumodeck/game-studio",
  "license": "MIT",
  "keywords": [
    "game-studio",
    "level-editor",
    "placement",
    "assets",
    "threejs",
    "phaser",
    "pixijs",
    "godot",
    "gamedev",
    "games",
    "kumodeck"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/arrange/bin/studio.mjs\" --hook wait",
            "async": true,
            "asyncRewake": true,
            "timeout": 43200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/arrange/bin/studio.mjs\" --hook prompt",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/skills/arrange/bin/studio.mjs\" --hook wait",
            "async": true,
            "asyncRewake": true,
            "timeout": 43200
          }
        ]
      }
    ]
  }
}
